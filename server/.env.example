# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL="file:./dev.db"

# Server
PORT=4001
# Comma-separated list of allowed origins for CORS (the Vite dev server + preview).
CLIENT_ORIGIN="http://localhost:5173,http://localhost:4173"

# Auth. With NODE_ENV=production the server refuses to start unless JWT_SECRET
# is set, is not this example value, and is at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# Default admin account created by the seed script. ADMIN_PASSWORD is subject to
# the same production check — the seed will not create an account with the
# example password on a production host.
ADMIN_EMAIL="admin@radiantwaytravel.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="RadiantWay Admin"

# Number of reverse proxies in front of this server, used to resolve the real
# client IP for rate limiting. 1 = the bundled nginx. Increase if you add a CDN
# or load balancer in front of it.
TRUST_PROXY_HOPS=1

# Public base URL of this server (used to build absolute upload URLs).
PUBLIC_URL="http://localhost:4001"

# Live Google rating for the hero badge (GET /api/reviews/google).
# Create a key in Google Cloud → APIs & Services with the "Places API (New)"
# enabled, and restrict it to this server's IP. Find the Place ID with
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Leave both blank to fall back to the rating saved in Admin → Settings.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
