# RadiantWay Travel — production environment
#
# Import into Hostinger: Websites -> radiantwaytravel.com -> Node.js app ->
# Environment variables. Values are unquoted on purpose; hosting panels tend to
# store quotes as part of the value.
#
# ── Edit these four before importing ────────────────────────────────────────
#
#   JWT_SECRET            generated, 32+ characters
#   ADMIN_PASSWORD        your real admin password
#   DATABASE_URL          MySQL user, password and database name
#   UPLOAD_DIR            your hosting username
#
# They all carry a REPLACE_WITH_ marker. The server scans every variable for
# that marker and refuses to start in production on any of them, naming the
# variable — so an unedited import fails in one clear line on first boot
# instead of somewhere deep in the stack.
#
# Your hosting username is the u-number in the path hPanel shows for your
# site: /home/uXXXXXXXX/domains/radiantwaytravel.com. It is the same in both
# UPLOAD_DIR below and your MySQL credentials.
#
# server/.env.example is the equivalent for running the API on its own in
# local development. This file is the deployed one.


# ── Required ────────────────────────────────────────────────────────────────

# Activates the production checks. Without it the server silently accepts the
# example JWT secret, which is the one setting that undoes all the others.
NODE_ENV=production

# Signing key for admin sessions. Must be 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later signs every admin out; it does not affect site visitors.
JWT_SECRET=REPLACE_WITH_A_GENERATED_SECRET

# MySQL connection string. Create the database and user in hPanel -> Databases
# -> Management, then import server/prisma/radiantway_mysql_schema.sql into it
# through phpMyAdmin: the app does not create its own tables (see server.js).
#
# Host is localhost — the database sits on the same machine as the app. The
# database and user names Hostinger creates are both prefixed with your
# u-number, and both belong here in full.
#
# Percent-encode any of : / ? # [ ] @ in the password — %40 for @, %23 for #.
# An unencoded @ splits the URL in the wrong place and Prisma reports a host
# that does not exist.
DATABASE_URL=mysql://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@localhost:3306/REPLACE_WITH_DB_NAME

# This site's own address. Used to build absolute image URLs and always treated
# as an allowed CORS origin, so a same-origin contact-form post cannot be
# rejected. No trailing slash.
PUBLIC_URL=https://radiantwaytravel.com

# Password for the admin account, used only when the account is first created.
# Changing this later does nothing — change the password in the admin panel.
ADMIN_PASSWORD=REPLACE_WITH_A_REAL_PASSWORD


# ── Should be set ───────────────────────────────────────────────────────────

# Where admin-uploaded images are written. Keep it OUTSIDE the app directory:
# deploys land in domains/radiantwaytravel.com/hbuilds/versions/<id>/, a new
# folder every time, so anything written in there is gone on the next push.
# The directory creates itself on first boot.
UPLOAD_DIR=/home/REPLACE_WITH_YOUR_HOSTING_USERNAME/radiantway-data/uploads

# Browser origins allowed to call the API, comma separated, no spaces. Include
# the www variant if it resolves. PUBLIC_URL is allowed automatically.
CLIENT_ORIGIN=https://radiantwaytravel.com,https://www.radiantwaytravel.com

# Login for the admin panel at /admin.
ADMIN_EMAIL=admin@radiantwaytravel.com
ADMIN_NAME=RadiantWay Admin

# How many reverse proxies sit in front of this app. Used to recover the real
# client IP for rate limiting — set too low and one visitor's failed logins
# throttle everybody. 1 suits a standard single-proxy host; raise it if you put
# Cloudflare or a load balancer in front.
TRUST_PROXY_HOPS=1


# ── Optional ────────────────────────────────────────────────────────────────

# How long an admin session lasts.
JWT_EXPIRES_IN=7d

# Live Google rating for the hero badge. Leave both empty and the badge uses
# the rating stored in Admin -> Settings, which is how the site runs today.
# Filling them in makes it refresh itself every 6 hours instead.
# Enable "Places API (New)" in Google Cloud and restrict the key to this
# server's IP; the key is only ever read server-side.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=


# ── Do not set these ────────────────────────────────────────────────────────
#
# PORT           Hostinger assigns it. server.js reads process.env.PORT and
#                only falls back to 3000. Pinning it can bind the wrong port
#                and produce a 502.
#
# VITE_API_URL   Compiled into the frontend at build time, already defaulting
#                to /api. Setting it at runtime has no effect — it must be a
#                build argument.
